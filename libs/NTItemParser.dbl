/*

[Item-parser Syntax Information]

1. [Keyword] separates into two groups
   - [Property Keywords] : [Type], [Name], [Class], [Quality], [Flag], [Level], [Prefix], [Suffix]	//260618
   - [Stat Keywords] : [Number or Alias]

2. [Keyword] must be surrounded by '[' and ']'

3. [Property Keywords] must be placed first

4. Insert '#' symbol between [Property Keywords] and [Stat Keywords]

5. Use '+', '-', '*', '/', '(', ')', '&&', '||', '>', '>=', '<', '<=', '==', '!=' symbols for comparison

6. Use '//' symbol for comment

*/

include("NTItemAlias.dbl");

var NTIP = {},
	NTIP_CheckList = [],
	stringArray = [],
	NTIP_QuestItems = [87,88,89,90,91,92,173,174,521,524,525,545,546,547,548,549,552,553,554,555],	//260729
	NTIP_Lists = {	//260803
		common: [], tier: [], merc: [], qty: []
	};

NTIP.OpenFile = function (filepath, notify) {
	if (!FileTools.exists(filepath)) {
		if (notify) {
			Misc.errorReport("ÿc1NIP file doesn't exist: ÿc0" + filepath);
		}

		return false;
	}

	var i, nipfile, line, lines, info, item,
		tick = getTickCount(),
		filename = filepath.substring(filepath.lastIndexOf("/") + 1, filepath.length),
		entries = 0;

	try {
		nipfile = File.open(filepath, 0);
	} catch (fileError) {
		if (notify) {
			Misc.errorReport("ÿc1Failed to load NIP: ÿc0" + filename);
		}
	}

	if (!nipfile) {
		return false;
	}
	
	lines = nipfile.readAllLines();

	nipfile.close();

	for (i = 0; i < lines.length; i += 1) {
		info = {
			line: i + 1,
			file: filename,
			string: lines[i]
		};

		line = NTIP.ParseLineInt(lines[i], info);

		if (line) {
			entries += 1;

			NTIP_CheckList.push(line);
			stringArray.push(info);
			
			var rule = line[2] || null,
				pair = [line, info];

			if (!rule || (!rule.hasOwnProperty("Tier") && !rule.hasOwnProperty("Merc") && !rule.hasOwnProperty("Qty"))) {
				NTIP_Lists.common.push(pair);
			} else {
				if (rule.hasOwnProperty("Tier")) {
					NTIP_Lists.tier.push(pair);
				}
				
				if (rule.hasOwnProperty("Merc")) {
					NTIP_Lists.merc.push(pair);
				}
				
				if (rule.hasOwnProperty("Qty")) {
					NTIP_Lists.qty.push(pair);
				}
			}
		}
	}

	//if (notify) {
		//print("ÿc4Loaded NIP: ÿc2" + filename + "ÿc4. Lines: ÿc2" + lines.length + "ÿc4. Valid entries: ÿc2" + entries + ". ÿc4Time: ÿc2" + (getTickCount() - tick) + " ms");
	//}

	return true;
};

NTIP.SortLists = function () {	//260803
	NTIP_Lists.tier.sort(function (a, b) { return b[0][2].Tier - a[0][2].Tier; });
	NTIP_Lists.merc.sort(function (a, b) { return b[0][2].Merc - a[0][2].Merc; });
	NTIP_Lists.qty.sort(function (a, b) { return b[0][2].Qty - a[0][2].Qty; });
};

NTIP.CheckQuantityOwned = function (item_type, item_stats, selfGid) {	//260816
	var i, item,
		num = 0,
		items = me.getItems(),
		merc = me.getMerc(),
		mercItems = merc ? merc.getItems() : null;

	if (!items) {
		print("I can't find my items!");
		return { count: 0 };
	}

	for (i = 0; i < items.length; i += 1) {
		if ((items[i].mode === 0 && (items[i].location === 7 || items[i].location === 3)) || items[i].mode === 1) {
			item = items[i];

			if (item.gid === selfGid) {
				continue;
			}

			if ((item_type !== null && item_type.length > 0 && eval(item_type)) || item_type === null) {
				if ((item_stats !== null && item_stats.length > 0 && eval(item_stats)) || item_stats === null) {
					num += 1;
				}
			}
		}
	}
	
	if (mercItems) {
		for (i = 0; i < mercItems.length; i += 1) {
			item = mercItems[i];

			if (item.gid === selfGid) {
				continue;
			}

			if ((item_type !== null && item_type.length > 0 && eval(item_type)) || item_type === null) {
				if ((item_stats !== null && item_stats.length > 0 && eval(item_stats)) || item_stats === null) {
					num += 1;
				}
			}
		}
	}

	return { count: num };
};

NTIP.GetScore = function (item, key) {	//2608010
	// key: "Tier" or "Merc"
	
	//quest item pre-check
	if (NTIP_QuestItems.indexOf(item.classid) > -1) {
		return 0;
	}

	//unid pre-check
    if (!item.getFlag(0x10)) {
        return 0;
    }

	var i, entry, sec0, sec1, rule, holdRule, holdCount, tiered,
		list = NTIP_Lists[key.toLowerCase()],
		score = 0;
	
	for (i = 0; i < list.length; i += 1) {
		entry = list[i][0];
		sec0 = entry[0];
		sec1 = entry[1];
		rule = entry[2] || null;

		try {
			//tiered
			if (rule && rule.hasOwnProperty("Tiered")) {
				tiered = rule.Tiered === 0 ? Config.Tiered : Config.TieredGear[Config.Gear[rule.Tiered]];

				if (rule.TieredNegate ? tiered : !tiered) {
					continue;
				}
			}

			//sec0
			if (sec0 && sec0.length > 0) {
				if (!eval(sec0)) {
					continue;
				}
			}
			
			//unid already checked

			//sec1
			if (sec1 && sec1.length > 0) {
				if (!eval(sec1)) {
					continue;
				}
			}

			//hold (qty only)
			if (entry[3] !== undefined) {
				holdRule = entry[5] || null;

				if (holdRule && holdRule.hasOwnProperty("Qty")) {
					holdCount = NTIP.CheckQuantityOwned(
						entry[3] || null,
						entry[4] || null,
						item.gid
					);

					if (!eval(holdCount.count + holdRule.Qty)) {
						continue;
					}
				}
			}

			//first matched
			score = rule[key];
			break;
		} catch (e) {
			continue;
		}
	}

	return score;
};

NTIP.EvaluateItem = function (item, list) {	//260804
	// evaluates item against a list, returns first match or null
	var i, entry, sa, sec0, sec1, rule, holdRule, holdCount, j, bodyLoc, allHigher,
		isPair = list.length > 0 && Array.isArray(list[0][0]);

	for (i = 0; i < list.length; i += 1) {
		entry = isPair ? list[i][0] : list[i];
		sa = isPair ? list[i][1] : null;
		sec0 = entry[0];
		sec1 = entry[1];
		rule = entry[2] || null;

		try {
			//gate1 - tiered
			if (rule && rule.hasOwnProperty("Tiered")) {
				var tiered = rule.Tiered === 0 ? Config.Tiered : Config.TieredGear[Config.Gear[rule.Tiered]];	//260805
				
				if (rule.TieredNegate ? tiered : !tiered) {
					continue;
				}
			}

			//gate2 - sec0
			if (sec0 && sec0.length > 0) {
				if (!eval(sec0)) {
					continue;
				}
			}

			//gate3 - unid
			if (sec1 && sec1.length > 0 && !item.getFlag(0x10)) {
				return {
					result: -1,
					tier: 0,
					merc: 0,
					qty: null,
					reason: "unid",
					line: NTIP.buildLineStr(sa, 0, 0, null, null, null)
				};
			}

			//gate4 - sec1
			if (sec1 && sec1.length > 0) {
				if (!eval(sec1)) {
					continue;
				}
			}

			//gate5 - hold (qty only)
			if (entry[3] !== undefined) {
				holdRule = entry[5] || null;

				if (holdRule && holdRule.hasOwnProperty("Qty")) {
					holdCount = NTIP.CheckQuantityOwned(
						entry[3] || null,
						entry[4] || null,
						item.gid
					);

					if (!eval(holdCount.count + holdRule.Qty)) {
						continue;
					}
				}
			}

			//gate6 - tier
			// str/dex requirement check is handled in autoEquip path (GetScore), not here (260803)
			if (rule && rule.Tier) {
				bodyLoc = Equip.getBodyLoc(item);
				
				if (!bodyLoc) {
					continue;
				}
				
				if (!item.getFlag(0x10)) {
					continue;
				}
				
				allHigher = true;

				for (j = 0; j < bodyLoc.length; j += 1) {
					var cached = Config.TierNow[Config.Gear[bodyLoc[j]]];
					
					if (rule.Tier > cached.tier && item.strreq <= me.getStat(0) - cached.str && item.dexreq <= me.getStat(2) - cached.dex) {
						allHigher = false;
						break;
					}
				}

				if (allHigher) {
					continue;
				}
			}

			//gate7 - merc
			if (rule && rule.Merc) {
				if (!Config.UseMerc) {	//260814
					continue;
				}
				
				bodyLoc = Grant.getBodyLoc(item);
				
				if (!bodyLoc) {
					continue;
				}
				
				if (!(rule.Merc > Config.TierMerc[Config.Gear[bodyLoc[0]]].merc && Grant.canEquip(item, bodyLoc[0], true))) {
					continue;
				}
			}

			//gate8 - qty
			if (rule && rule.hasOwnProperty("Qty")) {
				var owned = NTIP.CheckQuantityOwned(
					(sec0 && sec0.length > 0) ? sec0 : null,
					(sec1 && sec1.length > 0) ? sec1 : null,
					item.gid
				);

				if (owned.count >= rule.Qty) {
					continue;
				}
			}

			//result - first matched
			return {
				result: 1,
				tier: (rule && rule.Tier) ? rule.Tier : 0,
				merc: (rule && rule.Merc) ? rule.Merc : 0,
				qty: (rule && rule.hasOwnProperty("Qty")) ? rule.Qty : null,
				reason: "matched",
				line: NTIP.buildLineStr(sa,
					(rule && rule.Merc) ? rule.Merc : 0,
					(rule && rule.Tier) ? rule.Tier : 0,
					(rule && rule.hasOwnProperty("Qty")) ? rule.Qty : null,
					(rule && rule.hasOwnProperty("Tiered")) ? rule.Tiered : null,
					(rule && rule.TieredNegate) ? true : false)
			};
		} catch (e) {
			continue;
		}
	}

	return {
		result: 0,
		tier: 0,
		merc: 0,
		qty: null,
		reason: "unmatched",
		line: null
	};
};

NTIP.Evaluate = function (item) {	//260807
	// gate function — evaluates split lists in priority order
	var result;

	//list1 - common
	result = NTIP.EvaluateItem(item, NTIP_Lists.common);
	if (result.result) {
		return result;
	}

	//list2 - tier
	result = NTIP.EvaluateItem(item, NTIP_Lists.tier);
	if (result.result) {
		return result;
	}

	//list3 - merc
	result = NTIP.EvaluateItem(item, NTIP_Lists.merc);
	if (result.result) {
		return result;
	}
	
	//list4 - qty
	result = NTIP.EvaluateItem(item, NTIP_Lists.qty);
	if (result.result) {
		return result;
	}

	return result;
};

NTIP.buildLineStr = function (sa, merc, tier, qty, tiered, tieredNegate) {
    if (!sa) {
		return null;
	}
	
    var str = "(" + sa.file.replace(/^.*[\\\/]/, "").replace(/\.nip$/i, "") + ")#" + sa.line;
	
	if (merc > 0) {
		str += " / (Merc)#" + merc;
	}
	
    if (tier > 0) {
		str += " / (Tier)#" + tier;
	}
	
    if (qty !== null) {
		str += " / (Qty)#" + qty;
	}
	
	if (tiered !== null) {
		str += " / " + (tieredNegate ? "(!Tiered)" : "(Tiered)") + "#" + tiered;
	}
	
    return str;
};

NTIP.IsSyntaxInt = function (ch) {
	return (ch === '!' || ch === '%' || ch === '&' || (ch >= '(' && ch <= '+') || ch === '-' || ch === '/' || (ch >= ':' && ch <= '?') || ch === '|');
};

NTIP.ParseLineInt = function (input, info) {
	var i, property, p_start, p_end, p_section, p_keyword, p_result, value, opVal;	//260811

	p_end = input.indexOf("//");

	if (p_end !== -1) {
		input = input.substring(0, p_end);
	}

	input = input.replace(/\s+/g, "").toLowerCase();

	if (input.length < 5) {
		return null;
	}
	
	var nipParts = input.split("@"),	// 260515
		holdPart = nipParts[1] || null;

	input = nipParts[0];
	p_result = input.split("#");

	if (p_result[0] && p_result[0].length > 4) {
		p_section = p_result[0].split("[");

		p_result[0] = p_section[0];

		for (i = 1; i < p_section.length; i += 1) {
			p_end = p_section[i].indexOf("]") + 1;
			property = p_section[i].substring(0, p_end - 1);

			switch (property) {
			case 'color':
				p_result[0] += "item.getColor()";
				break;
			case 'type':
				p_result[0] += "item.itemType";
				break;
			case 'name':
				p_result[0] += "item.classid";
				break;
			case 'class':
				p_result[0] += "item.itemclass";
				break;
			case 'quality':
				p_result[0] += "item.quality";
				break;
			case 'flag':
				if (p_section[i][p_end] === '!') {
					p_result[0] += "!item.getFlag(";
				} else {
					p_result[0] += "item.getFlag(";
				}

				p_end += 2;
				break;
			case 'level':
				p_result[0] += "item.ilvl";
				break;
			case 'prefix':
				if (p_section[i][p_end] === '!') {
					p_result[0] += "!item.getPrefix(";
				} else {
					p_result[0] += "item.getPrefix(";
				}

				p_end += 2;
				break;
			case 'suffix':
				if (p_section[i][p_end] === '!') {
					p_result[0] += "!item.getSuffix(";
				} else {
					p_result[0] += "item.getSuffix(";
				}

				p_end += 2;
				break;

			default:
				Misc.errorReport("Unknown property: " + property + " File: " + info.file + " Line: " + info.line);
				return false;
			}

			for (p_start = p_end; p_end < p_section[i].length; p_end += 1) {
				if (!NTIP.IsSyntaxInt(p_section[i][p_end])) {
					break;
				}
			}

			p_result[0] += p_section[i].substring(p_start, p_end);

			if (p_section[i].substring(p_start, p_end) === "=") {
				Misc.errorReport("Unexpected = at line " + info.line + " in " + info.file);
				return false;
			}

			for (p_start = p_end; p_end < p_section[i].length; p_end += 1) {
				if (NTIP.IsSyntaxInt(p_section[i][p_end])) {
					break;
				}
			}

			p_keyword = p_section[i].substring(p_start, p_end);

			if (isNaN(p_keyword)) {
				switch (property) {
				case 'color':
					if (NTIPAliasColor[p_keyword] === undefined) {
						Misc.errorReport("Unknown color: " + p_keyword + " File: " + info.file + " Line: " + info.line);
						return false;
					}

					p_result[0] += NTIPAliasColor[p_keyword];
					break;
				case 'type':
					if (NTIPAliasType[p_keyword] === undefined) {
						Misc.errorReport("Unknown type: " + p_keyword + " File: " + info.file + " Line: " + info.line);
						return false;
					}

					p_result[0] += NTIPAliasType[p_keyword];
					break;
				case 'name':
					if (NTIPAliasClassID[p_keyword] === undefined) {
						Misc.errorReport("Unknown name: " + p_keyword + " File: " + info.file + " Line: " + info.line);
						return false;
					}

					p_result[0] += NTIPAliasClassID[p_keyword];
					break;
				case 'class':
					if (NTIPAliasClass[p_keyword] === undefined) {
						Misc.errorReport("Unknown class: " + p_keyword + " File: " + info.file + " Line: " + info.line);
						return false;
					}

					p_result[0] += NTIPAliasClass[p_keyword];
					break;
				case 'quality':
					if (NTIPAliasQuality[p_keyword] === undefined) {
						Misc.errorReport("Unknown quality: " + p_keyword + " File: " + info.file + " Line: " + info.line);
						return false;
					}

					p_result[0] += NTIPAliasQuality[p_keyword];
					break;
				case 'flag':
					if (NTIPAliasFlag[p_keyword] === undefined) {
						Misc.errorReport("Unknown flag: " + p_keyword + " File: " + info.file + " Line: " + info.line);
						return false;
					}

					p_result[0] += NTIPAliasFlag[p_keyword] + ")";
					break;
				case 'prefix':
				case 'suffix':
					p_result[0] += "\"" + p_keyword + "\")";
					break;
				}
			} else {
				if (property === 'flag') {	//260810
					p_result[0] += p_keyword + ")";
				} else {
					p_result[0] += p_keyword;
				}
			}

			p_result[0] += p_section[i].substring(p_end);
		}
	} else {
		p_result[0] = "";
	}

	if (p_result[1] && p_result[1].length > 4) {
		p_section = p_result[1].split("[");
		p_result[1] = p_section[0];

		for (i = 1; i < p_section.length; i += 1) {
			p_end = p_section[i].indexOf("]");
			p_keyword = p_section[i].substring(0, p_end);

			if (/^\d+(,\d+)?$/.test(p_keyword)) {	//260816
				p_result[1] += "item.getStatEx(" + p_keyword + ")";
			} else {
				if (NTIPAliasStat[p_keyword] === undefined) {
					Misc.errorReport("Unknown stat: " + p_keyword + " File: " + info.file + " Line: " + info.line);
					return false;
				}

				p_result[1] += "item.getStatEx(" + NTIPAliasStat[p_keyword] + ")";
			}

			p_result[1] += p_section[i].substring(p_end + 1);
		}
	} else {
		p_result[1] = "";
	}

	if (p_result[2] && p_result[2].length > 0) {
		p_section = p_result[2].split("[");
		p_result[2] = {};

		for (i = 1; i < p_section.length; i += 1) {
			p_end = p_section[i].indexOf("]");
			p_keyword = p_section[i].substring(0, p_end);

			switch (p_keyword) {
			case "qty":
				value = Number(p_section[i].split("==")[1].match(/\d+/g));
				
				if (isNaN(value)) {	//260810 guard added
					Misc.errorReport("Unknown qty value: " + p_section[i] + " File: " + info.file + " Line: " + info.line);
					return false;
				}
				
				p_result[2].Qty = value;
				break;
			case "tier":
				value = Number(p_section[i].split("==")[1].match(/\d+/g));

				if (isNaN(value)) {	//260810 guard added
					Misc.errorReport("Unknown tier value: " + p_section[i] + " File: " + info.file + " Line: " + info.line);
					return false;
				}
				
				p_result[2].Tier = value;
				break;
			case "merc":
				value = Number(p_section[i].split("==")[1].match(/\d+/g));
				
				if (isNaN(value)) {	//260810 guard added
					Misc.errorReport("Unknown merc value: " + p_section[i] + " File: " + info.file + " Line: " + info.line);
					return false;
				}
				
				p_result[2].Merc = value;
				break;
			case "tiered":	//eom 260418
				value = Number(p_section[i].split(/!=|==/)[1].match(/\d+/g));
				
				if (isNaN(value) || value < 0 || value > 10) {
					Misc.errorReport("Unknown tiered value: " + p_section[i] + " File: " + info.file + " Line: " + info.line);
					return false;
				}
				
				p_result[2].Tiered = value;
				p_result[2].TieredNegate = p_section[i].indexOf("!=") > -1;
				break;
			default:
				Misc.errorReport("Unknown rule: " + p_keyword + " File: " + info.file + " Line: " + info.line);
				return false;
			}
		}
	}
	
	if (holdPart) {	// 260515
		var holdSections = holdPart.split("#"),
			holdSec0 = holdSections[0] || "",
			holdSec1 = holdSections[1] || "",
			holdSec2 = holdSections[2] || "";

		// holdSec0 parsing (=sec0 rule: property keywords)
		if (holdSec0.length > 4) {
			var hs0_section = holdSec0.split("[");
			
			holdSec0 = hs0_section[0];

			for (i = 1; i < hs0_section.length; i += 1) {
				p_end = hs0_section[i].indexOf("]") + 1;
				property = hs0_section[i].substring(0, p_end - 1);

				switch (property) {
				case 'color':
					holdSec0 += "item.getColor()";
					break;
				case 'type':
					holdSec0 += "item.itemType";
					break;
				case 'name':
					holdSec0 += "item.classid";
					break;
				case 'class':
					holdSec0 += "item.itemclass";
					break;
				case 'quality':
					holdSec0 += "item.quality";
					break;
				case 'flag':
					holdSec0 += (hs0_section[i][p_end] === '!') ? "!item.getFlag(" : "item.getFlag(";
					p_end += 2;
					break;
				case 'level':
					holdSec0 += "item.ilvl";
					break;
				case 'prefix':
					holdSec0 += (hs0_section[i][p_end] === '!') ? "!item.getPrefix(" : "item.getPrefix(";
					p_end += 2;
					break;
				case 'suffix':
					holdSec0 += (hs0_section[i][p_end] === '!') ? "!item.getSuffix(" : "item.getSuffix(";
					p_end += 2;
					break;
				default:
					Misc.errorReport("Unknown hold property: " + property + " File: " + info.file + " Line: " + info.line);
					return false;
				}

				for (p_start = p_end; p_end < hs0_section[i].length; p_end += 1) {
					if (!NTIP.IsSyntaxInt(hs0_section[i][p_end])) {
						break;
					}
				}
				
				holdSec0 += hs0_section[i].substring(p_start, p_end);

				for (p_start = p_end; p_end < hs0_section[i].length; p_end += 1) {
					if (NTIP.IsSyntaxInt(hs0_section[i][p_end])) {
						break;
					}
				}
				
				p_keyword = hs0_section[i].substring(p_start, p_end);
				
				if (isNaN(p_keyword)) {	//260810 guard added (align with sec0)
					if (property === 'color') {
						if (NTIPAliasColor[p_keyword] === undefined) {
							Misc.errorReport("Unknown hold color: " + p_keyword + " File: " + info.file + " Line: " + info.line);
							return false;
						}
						
						holdSec0 += NTIPAliasColor[p_keyword];
					} else if (property === 'type') {
						if (NTIPAliasType[p_keyword] === undefined) {
							Misc.errorReport("Unknown hold type: " + p_keyword + " File: " + info.file + " Line: " + info.line);
							return false;
						}
						
						holdSec0 += NTIPAliasType[p_keyword];
					} else if (property === 'name') {
						if (NTIPAliasClassID[p_keyword] === undefined) {
							Misc.errorReport("Unknown hold name: " + p_keyword + " File: " + info.file + " Line: " + info.line);
							return false;
						}
						
						holdSec0 += NTIPAliasClassID[p_keyword];
					} else if (property === 'class') {
						if (NTIPAliasClass[p_keyword] === undefined) {
							Misc.errorReport("Unknown hold class: " + p_keyword + " File: " + info.file + " Line: " + info.line);
							return false;
						}
						holdSec0 += NTIPAliasClass[p_keyword];
					} else if (property === 'quality') {
						if (NTIPAliasQuality[p_keyword] === undefined) {
							Misc.errorReport("Unknown hold quality: " + p_keyword + " File: " + info.file + " Line: " + info.line);
							return false;
						}
						
						holdSec0 += NTIPAliasQuality[p_keyword];
					} else if (property === 'flag') {
						if (NTIPAliasFlag[p_keyword] === undefined) {
							Misc.errorReport("Unknown hold flag: " + p_keyword + " File: " + info.file + " Line: " + info.line);
							return false;
						}
						
						holdSec0 += NTIPAliasFlag[p_keyword] + ")";
					} else if (property === 'prefix' || property === 'suffix') {
						holdSec0 += "\"" + p_keyword + "\")";
					}
				} else {
					holdSec0 += (property === 'flag') ? p_keyword + ")" : p_keyword;
				}

				holdSec0 += hs0_section[i].substring(p_end);
			}
		}

		// holdSec1 parsing (=sec1 rule: stat keywords)
		if (holdSec1.length > 4) {
			var hs1_section = holdSec1.split("[");
			
			holdSec1 = hs1_section[0];

			for (i = 1; i < hs1_section.length; i += 1) {
				p_end = hs1_section[i].indexOf("]");
				p_keyword = hs1_section[i].substring(0, p_end);

				if (/^\d+(,\d+)?$/.test(p_keyword)) {	//260816
					holdSec1 += "item.getStatEx(" + p_keyword + ")";
				} else {
					if (NTIPAliasStat[p_keyword] === undefined) {
						Misc.errorReport("Unknown hold stat: " + p_keyword + " File: " + info.file + " Line: " + info.line);
						return false;
					}
					holdSec1 += "item.getStatEx(" + NTIPAliasStat[p_keyword] + ")";
				}
				
				holdSec1 += hs1_section[i].substring(p_end + 1);
			}
		}

		// holdSec2 parsing (=sec2 rule: rule keywords)
		if (holdSec2.length > 0) {
			var hs2_section = holdSec2.split("["),
				holdRule = {};

			for (i = 1; i < hs2_section.length; i += 1) {
				p_end = hs2_section[i].indexOf("]");
				p_keyword = hs2_section[i].substring(0, p_end);

				switch (p_keyword) {	//260811
				case "qty":
					opVal = hs2_section[i].substring(p_end + 1).match(/(<=|>=|==|<|>)\s*\d+/);
					
					if (!opVal) {
						Misc.errorReport("Unknown hold qty value: " + hs2_section[i] + " File: " + info.file + " Line: " + info.line);
						return false;
					}
					
					holdRule.Qty = opVal[0];
					break;
				default:
					Misc.errorReport("Unknown hold rule: " + p_keyword + " File: " + info.file + " Line: " + info.line);
					return false;
				}
			}
			holdSec2 = holdRule;
		} else {
			holdSec2 = null;
		}

		p_result[3] = holdSec0;	// 260515
		p_result[4] = holdSec1;	// 260515
		p_result[5] = holdSec2;	// 260515
	}

	return p_result;
};
