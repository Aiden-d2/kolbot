/*

[Item-parser Syntax Information]

1. [Keyword] separates into two groups
   - [Property Keywords] : [Type], [Name], [Class], [Quality], [Flag], [Level], [Prefix], [Suffix]	//260618
   - [Stat Keywords] : [Number or Alias]

2. [Keyword] must be surrounded by '[' and ']'

3. [Property Keywords] must be placed first

4. Insert '#' symbol between [Property Keywords] and [Stat Keywords]

5. Use '+', '-', '*', '/', '(', ')', '&&', '||', '>', '>=', '<', '<=', '==', '!=' symbols for comparison

6. Use '//' symbol for comment

*/

include("tools/NTItemAlias.dbl");

var NTIP = {},
	NTIP_CheckList = [],
	stringArray = [],
	NTIP_QuestItems = [87,88,89,90,91,92,173,174,521,524,525,545,547,548,549,552,553,554,555],	//260729	//261002 546 (Jade Figurine) out: it is picked by its nip rule (X.nip)
	NTIP_Lists = {	//260803
		common: [], tier: [], merc: [], qty: []
	};

NTIP.OpenFile = function (filepath, notify) {
	if (!FileTools.exists(filepath)) {
		if (notify) {
			Misc.errorReport("ÿc1NIP file doesn't exist: ÿc0" + filepath);
		}

		return false;
	}

	var i, nipfile, line, lines, info, item,
		tick = getTickCount(),
		filename = filepath.substring(filepath.lastIndexOf("/") + 1, filepath.length),
		entries = 0;

	try {
		nipfile = File.open(filepath, 0);
	} catch (fileError) {
		if (notify) {
			Misc.errorReport("ÿc1Failed to load NIP: ÿc0" + filename);
		}
	}

	if (!nipfile) {
		return false;
	}
	
	lines = nipfile.readAllLines();

	nipfile.close();

	for (i = 0; i < lines.length; i += 1) {
		info = {
			line: i + 1,
			file: filename,
			string: lines[i]
		};

		line = NTIP.ParseLineInt(lines[i], info);

		if (line) {
			entries += 1;

			NTIP_CheckList.push(line);
			stringArray.push(info);
			
			var rule = line[2] || null,
				pair = [line, info];

			if (!rule || (!rule.hasOwnProperty("Tier") && !rule.hasOwnProperty("Merc") && !rule.hasOwnProperty("Qty"))) {
				NTIP_Lists.common.push(pair);
			} else {
				if (rule.hasOwnProperty("Tier")) {
					NTIP_Lists.tier.push(pair);
				}
				
				if (rule.hasOwnProperty("Merc")) {
					NTIP_Lists.merc.push(pair);
				}
				
				if (rule.hasOwnProperty("Qty")) {
					NTIP_Lists.qty.push(pair);
				}
			}
		}
	}

	return true;
};

NTIP.SortLists = function () {	//260803
	NTIP_Lists.tier.sort(function (a, b) { return b[0][2].Tier - a[0][2].Tier; });
	NTIP_Lists.merc.sort(function (a, b) { return b[0][2].Merc - a[0][2].Merc; });
	NTIP_Lists.qty.sort(function (a, b) { return b[0][2].Qty - a[0][2].Qty; });
};

NTIP.CheckQuantityOwned = function (item_type, item_stats, selfGid) {	//260816
	var i, item,
		num = 0,
		items = me.getItems(),
		merc = me.getMerc(),
		mercItems = merc ? merc.getItems() : null;

	if (!items) {
		print("I can't find my items!");
		return { count: 0 };
	}

	for (i = 0; i < items.length; i += 1) {
		if ((items[i].mode === 0 && (items[i].location === 7 || items[i].location === 3)) || items[i].mode === 1) {
			item = items[i];

			if (item.gid === selfGid) {
				continue;
			}

			if ((item_type !== null && item_type.length > 0 && eval(item_type)) || item_type === null) {
				if ((item_stats !== null && item_stats.length > 0 && eval(item_stats)) || item_stats === null) {
					num += 1;
				}
			}
		}
	}
	
	if (mercItems) {
		for (i = 0; i < mercItems.length; i += 1) {
			item = mercItems[i];

			if (item.gid === selfGid) {
				continue;
			}

			if ((item_type !== null && item_type.length > 0 && eval(item_type)) || item_type === null) {
				if ((item_stats !== null && item_stats.length > 0 && eval(item_stats)) || item_stats === null) {
					num += 1;
				}
			}
		}
	}

	return { count: num };
};

NTIP.IsBroken = function (item) {	//260916
	// durability 0, has max durability, not indestructible
	return item.getStat(72) === 0 && item.getStat(73) > 0 && !item.getStat(152);
};

NTIP.GetScore = function (item, key) {	//2608010
	// key: "Tier" or "Merc"
	
	//quest item pre-check
	if (NTIP_QuestItems.indexOf(item.classid) > -1) {
		return 0;
	}

	//unid pre-check
    if (!item.getFlag(0x10)) {
        return 0;
    }

	var i, entry, sec0, sec1, rule, holdRule, holdCount,	//261028 tiered var out
		list = NTIP_Lists[key.toLowerCase()],
		score = 0;
	
	for (i = 0; i < list.length; i += 1) {
		entry = list[i][0];
		sec0 = entry[0];
		sec1 = entry[1];
		rule = entry[2] || null;

		try {
			//tiered
			if (rule && rule.hasOwnProperty("Tiered") && !Config.Tiered) {	//261028 [tiered] marker
				continue;
			}

			//sec0
			if (sec0 && sec0.length > 0) {
				if (!eval(sec0)) {
					continue;
				}
			}
			
			//unid already checked

			//sec1
			if (sec1 && sec1.length > 0) {
				if (!eval(sec1)) {
					continue;
				}
			}

			//hold (owned only)	//261028
			if (entry[3] !== undefined) {
				holdRule = entry[5] || null;

				if (holdRule && holdRule.hasOwnProperty("Owned")) {	//261028
					holdCount = NTIP.CheckQuantityOwned(
						entry[3] || null,
						entry[4] || null,
						item.gid
					);

					if (!eval(holdCount.count + holdRule.Owned)) {	//261028
						continue;
					}
				}
			}

			//first matched
			score = rule[key];
			break;
		} catch (e) {
			continue;
		}
	}
	
	if (score > 0) {	//260916
		if (NTIP.IsBroken(item)) {
			return 0;
		}

		if (key === "Tier" && (item.strreq > me.getStat(0) || item.dexreq > me.getStat(2))) {
			return 0;
		}

		if (key === "Merc" && (item.strreq > Config.MercStat.str || item.dexreq > Config.MercStat.dex)) {
			return 0;
		}
	}

	return score;
};

NTIP.EvaluateItem = function (item, list) {	//260804
	// evaluates item against a list, returns first match or null
	var i, entry, sa, sec0, sec1, rule, holdRule, holdCount, j, bodyLoc, allHigher,
		isPair = list.length > 0 && Array.isArray(list[0][0]);

	for (i = 0; i < list.length; i += 1) {
		entry = isPair ? list[i][0] : list[i];
		sa = isPair ? list[i][1] : null;
		sec0 = entry[0];
		sec1 = entry[1];
		rule = entry[2] || null;

		try {
			//gate1 - tiered
			if (rule && rule.hasOwnProperty("Tiered") && !Config.Tiered) {	//261028 [tiered] marker
				continue;
			}

			//gate1b - gear tier	//261025
			if (rule && rule.TierCheck && !eval(rule.TierCheck)) {	//261025 [armor] < 21 etc, cached tier only	//261028 key names
				continue;
			}

			//gate2 - sec0
			if (sec0 && sec0.length > 0) {
				if (!eval(sec0)) {
					continue;
				}
			}

			//gate3 - unid
			if (sec1 && sec1.length > 0 && !item.getFlag(0x10)) {
				return {
					result: -1,
					tier: 0,
					merc: 0,
					qty: null,
					reason: "unid",
					line: NTIP.buildLineStr(sa, 0, 0, null, null, null)
				};
			}

			//gate4 - sec1
			if (sec1 && sec1.length > 0) {
				if (!eval(sec1)) {
					continue;
				}
			}

			//gate5 - hold (owned only)	//261028
			if (entry[3] !== undefined) {
				holdRule = entry[5] || null;

				if (holdRule && holdRule.hasOwnProperty("Owned")) {	//261028
					holdCount = NTIP.CheckQuantityOwned(
						entry[3] || null,
						entry[4] || null,
						item.gid
					);

					if (!eval(holdCount.count + holdRule.Owned)) {	//261028
						continue;
					}
				}
			}

			//gate6 - tier
			if (rule && rule.Tier) {
				bodyLoc = Equip.getBodyLoc(item);
				
				if (!bodyLoc) {
					continue;
				}
				
				if (!item.getFlag(0x10)) {
					continue;
				}
				
				if (NTIP.IsBroken(item)) {	//260916
					continue;
				}
				
				allHigher = true;

				for (j = 0; j < bodyLoc.length; j += 1) {
					var cached = Config.TierNow[Config.Gear[bodyLoc[j]]];
					
					if (rule.Tier > cached.tier && item.strreq <= me.getStat(0) - cached.str && item.dexreq <= me.getStat(2) - cached.dex) {
						allHigher = false;
						break;
					}
				}

				if (allHigher) {
					continue;
				}
			}

			//gate7 - merc
			if (rule && rule.Merc) {
				if (!Config.UseMerc) {	//260814
					continue;
				}
				
				bodyLoc = Grant.getBodyLoc(item);
				
				if (!bodyLoc) {
					continue;
				}
				
				if (NTIP.IsBroken(item)) {	//260916
					continue;
				}
				
				//unid flag included
				if (!(rule.Merc > Config.TierMerc[Config.Gear[bodyLoc[0]]].merc && Grant.canEquip(item, bodyLoc[0], true))) {
					continue;
				}
			}

			//gate8 - qty
			if (rule && rule.hasOwnProperty("Qty")) {
				var owned = NTIP.CheckQuantityOwned(
					(sec0 && sec0.length > 0) ? sec0 : null,
					(sec1 && sec1.length > 0) ? sec1 : null,
					item.gid
				);

				if (owned.count >= rule.Qty) {
					continue;
				}
			}

			//result - first matched
			return {
				result: 1,
				tier: (rule && rule.Tier) ? rule.Tier : 0,
				merc: (rule && rule.Merc) ? rule.Merc : 0,
				qty: (rule && rule.hasOwnProperty("Qty")) ? rule.Qty : null,
				reason: "matched",
				line: NTIP.buildLineStr(sa,
					(rule && rule.Merc) ? rule.Merc : 0,
					(rule && rule.Tier) ? rule.Tier : 0,
					(rule && rule.hasOwnProperty("Qty")) ? rule.Qty : null,
					(rule && rule.hasOwnProperty("Tiered")) ? true : false,	//261028 TieredNegate out
					(rule && rule.TierCheckStr) ? rule.TierCheckStr : null)	//261025
			};
		} catch (e) {
			continue;
		}
	}

	return {
		result: 0,
		tier: 0,
		merc: 0,
		qty: null,
		reason: "unmatched",
		line: null
	};
};

NTIP.Evaluate = function (item) {	//260807
	// gate function — evaluates split lists in priority order
	var result;

	//quest item pre-check, same as GetScore	//261002
	if (NTIP_QuestItems.indexOf(item.classid) > -1) {
		return {
			result: 0,
			tier: 0,
			merc: 0,
			qty: null,
			reason: "quest",
			line: null
		};
	}

	//list1 - common
	result = NTIP.EvaluateItem(item, NTIP_Lists.common);
	if (result.result) {
		return result;
	}

	//list2 - tier
	result = NTIP.EvaluateItem(item, NTIP_Lists.tier);
	if (result.result) {
		return result;
	}

	//list3 - merc
	result = NTIP.EvaluateItem(item, NTIP_Lists.merc);
	if (result.result) {
		return result;
	}
	
	//list4 - qty
	result = NTIP.EvaluateItem(item, NTIP_Lists.qty);
	if (result.result) {
		return result;
	}

	return result;
};

NTIP.buildLineStr = function (sa, merc, tier, qty, tiered, tierCheck) {	//261025 tierCheck added	//261028 tieredNegate out
    if (!sa) {
		return null;
	}
	
    var str = "(" + sa.file.replace(/^.*[\\\/]/, "").replace(/\.nip$/i, "") + ")#" + sa.line;
	
	if (merc > 0) {
		str += " / (Merc)#" + merc;
	}
	
    if (tier > 0) {
		str += " / (Tier)#" + tier;
	}
	
    if (qty !== null) {
		str += " / (Qty)#" + qty;
	}
	
	if (tiered) {	//261028 [tiered] marker
		str += " / (Tiered)";
	}

	if (tierCheck) {	//261025 e.g. / (ArmG<41)	//261028 key names
		str += " / " + tierCheck;
	}

    return str;
};

NTIP.ParseLineInt = function (input, info) {	//261028 rewritten: one reader per section, syntax check, hold [owned], gear goal
	var p_end, nipParts, mainSec, holdSec, p_result;

	p_end = input.indexOf("//");

	if (p_end !== -1) {
		input = input.substring(0, p_end);
	}

	input = input.replace(/\s+/g, "").toLowerCase();

	if (input.length < 5) {
		return null;
	}

	nipParts = input.split("@");	//261028

	if (nipParts.length > 2) {	//261028 shown only, extra part ignored as before
		Misc.errorReport("More than one @ (extra part ignored) File: " + info.file + " Line: " + info.line);
	}

	mainSec = nipParts[0].split("#");	//261028

	if (mainSec.length > 3) {	//261028 shown only, extra section ignored as before
		Misc.errorReport("More than two # (extra section ignored) File: " + info.file + " Line: " + info.line);
	}

	p_result = [];
	p_result[0] = NTIP.ParseExpr(mainSec[0] || "", "property", info);	//261028

	if (p_result[0] === false) {
		return false;
	}

	p_result[1] = NTIP.ParseExpr(mainSec[1] || "", "stat", info);	//261028

	if (p_result[1] === false) {
		return false;
	}

	if (mainSec[2]) {	//261028
		p_result[2] = NTIP.ParseRule(mainSec[2], false, info);

		if (p_result[2] === false) {
			return false;
		}
	}

	if (nipParts[1]) {	//261028 hold: same readers as the main part (empty after @ = no hold, as before)
		holdSec = nipParts[1].split("#");

		if (holdSec.length > 3) {	//261028 shown only
			Misc.errorReport("More than two # in hold (extra section ignored) File: " + info.file + " Line: " + info.line);
		}

		p_result[3] = NTIP.ParseExpr(holdSec[0] || "", "property", info);

		if (p_result[3] === false) {
			return false;
		}

		p_result[4] = NTIP.ParseExpr(holdSec[1] || "", "stat", info);

		if (p_result[4] === false) {
			return false;
		}

		p_result[5] = NTIP.ParseRule(holdSec[2] || "", true, info);

		if (p_result[5] === false) {
			return false;
		}
	}

	return p_result;
};

// Reads a property or stat section into a js expression and checks its syntax, returns "" (empty), the expression or false	//261028
NTIP.ParseExpr = function (sec, kind, info) {	//261028
	var key, op, value, token, end, group,
		pos = 0,
		out = "",
		groups = [{and: false, or: false}],
		where = " File: " + info.file + " Line: " + info.line,
		propertyMap = {
			color: "item.getColor()", type: "item.itemType", name: "item.classid", "class": "item.itemclass", quality: "item.quality",
			flag: "item.getFlag(", level: "item.ilvl", prefix: "item.getPrefix(", suffix: "item.getSuffix("
		},
		aliasMap = {
			color: NTIPAliasColor, type: NTIPAliasType, name: NTIPAliasClassID, "class": NTIPAliasClass, quality: NTIPAliasQuality, flag: NTIPAliasFlag
		};

	if (!sec) {
		return "";
	}

	while (pos < sec.length) {
		if (sec[pos] === "[") {
			end = sec.indexOf("]", pos);

			if (end === -1) {
				Misc.errorReport("Missing ] after " + sec.substring(pos) + where);
				return false;
			}

			key = sec.substring(pos + 1, end);
			pos = end + 1;

			if (kind === "stat") {
				if (/^\d+(,\d+)?$/.test(key)) {
					out += "item.getStatEx(" + key + ")";
				} else if (NTIPAliasStat[key] !== undefined) {
					out += "item.getStatEx(" + NTIPAliasStat[key] + ")";
				} else {
					Misc.errorReport("Unknown stat: " + key + where);
					return false;
				}

				continue;
			}

			// property: [key] op value
			if (!propertyMap.hasOwnProperty(key)) {
				Misc.errorReport("Unknown property: " + key + where);
				return false;
			}

			op = sec.substring(pos).match(/^(==|!=|>=|<=|>|<)/);

			if (!op || sec[pos + op[0].length] === "=") {
				Misc.errorReport("Bad operator after [" + key + "]: " + sec.substring(pos, pos + 3) + where);
				return false;
			}

			op = op[0];
			pos += op.length;

			if (["flag", "prefix", "suffix"].indexOf(key) > -1 && op !== "==" && op !== "!=") {
				Misc.errorReport("Only == or != after [" + key + "]: " + op + where);
				return false;
			}

			value = sec.substring(pos).match(/^[a-z0-9_']+/);

			if (!value) {
				Misc.errorReport("Missing value after [" + key + "]" + op + where);
				return false;
			}

			value = value[0];
			pos += value.length;

			if (isNaN(value)) {
				if (key === "prefix" || key === "suffix") {
					value = "\"" + value + "\"";
				} else if (aliasMap[key] && aliasMap[key][value] !== undefined) {
					value = aliasMap[key][value];
				} else {
					Misc.errorReport("Unknown " + key + ": " + value + where);
					return false;
				}
			}

			if (key === "flag" || key === "prefix" || key === "suffix") {
				out += (op === "!=" ? "!" : "") + propertyMap[key] + value + ")";
			} else {
				out += propertyMap[key] + op + value;
			}

			continue;
		}

		// symbols and plain words between keywords: allowed list only
		token = sec.substring(pos).match(/^(&&|\|\||==|!=|>=|<=|>|<|[()+\-*\/]|\d+(\.\d+)?|[a-z_$][a-z0-9_$]*(\.[a-z_$][a-z0-9_$]*)*)/);

		if (!token || (/^(==|!=|>=|<=|>|<)$/.test(token[0]) && sec[pos + token[0].length] === "=")) {
			Misc.errorReport("Unexpected symbol: " + sec.substring(pos, pos + 3) + where);
			return false;
		}

		token = token[0];

		if (token === "(") {
			groups.push({and: false, or: false});
		} else if (token === ")") {
			group = groups.pop();

			if (!groups.length) {
				Misc.errorReport("Unbalanced )" + where);
				return false;
			}

			if (group.and && group.or) {
				Misc.errorReport("&& and || mixed in one ( ): use ( )" + where);
				return false;
			}
		} else if (token === "&&") {
			groups[groups.length - 1].and = true;
		} else if (token === "||") {
			groups[groups.length - 1].or = true;
		}

		out += token;
		pos += token.length;
	}

	if (groups.length > 1) {
		Misc.errorReport("Unclosed (" + where);
		return false;
	}

	if (groups[0].and && groups[0].or) {
		Misc.errorReport("&& and || mixed without ( ): use ( )" + where);
		return false;
	}

	try {
		new Function("item", "return (" + out + ");");
	} catch (e) {
		Misc.errorReport("Syntax error (" + e.message + ")" + where);
		return false;
	}

	return out;
};

// Reads the last section ([key] op value joined by &&) of the main part or the hold, returns the rule object or false	//261028
NTIP.ParseRule = function (sec, hold, info) {	//261028
	var i, m, key, op, value, gearKey, isMerc, gearList, g,
		rule = hold ? {Owned: "<1"} : {},	// hold without [owned] = skip when one or more owned
		seen = {},
		parts = sec ? sec.split("&&") : [],
		where = " File: " + info.file + " Line: " + info.line;

	for (i = 0; i < parts.length; i += 1) {
		if (parts[i] === "[tiered]" && !hold) {	// marker: all gear at TierGoal (Config.Tiered)
			if (seen.tiered) {	// shown only
				Misc.errorReport("Duplicate rule key: [tiered]" + where);
			}

			seen.tiered = true;
			rule.Tiered = true;
			continue;
		}

		m = parts[i].match(/^\[([a-z0-9]+)\](==|!=|<=|>=|<|>)([a-z0-9]+)$/);

		if (!m) {
			Misc.errorReport("Bad rule: " + parts[i] + " (use [key] op value joined by &&)" + where);
			return false;
		}

		key = m[1];
		op = m[2];
		value = m[3];

		if (seen[key]) {	// shown only, same result as before
			Misc.errorReport("Duplicate rule key: [" + key + "]" + where);
		}

		seen[key] = true;

		if (hold) {
			if (key !== "owned") {
				Misc.errorReport("Unknown hold rule: " + key + where);
				return false;
			}

			if (op === "!=" || isNaN(value)) {
				Misc.errorReport("Bad hold owned value: " + parts[i] + where);
				return false;
			}

			rule.Owned = op + value;
			continue;
		}

		switch (key) {
		case "tier":
		case "merc":
		case "qty":
			if (op !== "==" || isNaN(value)) {
				Misc.errorReport("Bad " + key + " value: " + parts[i] + " (only == number)" + where);
				return false;
			}

			rule[key === "tier" ? "Tier" : key === "merc" ? "Merc" : "Qty"] = Number(value);
			break;
		case "tiered":
			Misc.errorReport("[tiered] is a marker, write it without op and value: " + parts[i] + where);
			return false;
		default:	// gear tier gate: [armor] < 21 = cached Config.TierNow, [mercarmor] < 21 = cached Config.TierMerc, value goal = Config.TierGoal
			isMerc = key.indexOf("merc") === 0;
			gearList = isMerc ? Config.TierMerc : Config.TierNow;
			gearKey = null;

			for (g in gearList) {
				if (gearList.hasOwnProperty(g) && g.toLowerCase() === (isMerc ? key.substring(4) : key)) {
					gearKey = g;
				}
			}

			if (!gearKey) {
				Misc.errorReport("Unknown rule: " + key + where);
				return false;
			}

			if (op === "!=" || (isNaN(value) && value !== "goal")) {
				Misc.errorReport("Bad gear value: " + parts[i] + " (< <= > >= == with number or goal)" + where);
				return false;
			}

			if (isMerc && value === "goal") {
				Misc.errorReport("No goal for merc gear: " + parts[i] + where);
				return false;
			}

			rule.TierCheck = (rule.TierCheck ? rule.TierCheck + "&&" : "") +
				(isMerc ? "Config.UseMerc&&Config.TierMerc." + gearKey + ".merc" : "Config.TierNow." + gearKey + ".tier") + op +
				(value === "goal" ? "Config.TierGoal." + gearKey : value);
			rule.TierCheckStr = (rule.TierCheckStr || "") + "(" + (isMerc ? "Merc" : "") + gearKey + op + value + ")";	// item log
		}
	}

	if (rule.TierCheck && (rule.hasOwnProperty("Tier") || rule.hasOwnProperty("Merc"))) {	//261025 tier/merc line: gear tier ignored (GetScore does not see it either), line kept
		delete rule.TierCheck;
		delete rule.TierCheckStr;
		Misc.trace("NTIP: gear tier ignored on tier/merc line File: " + info.file + " Line: " + info.line);
	}

	return rule;
};
